{
  "name": "@midnight-ntwrk/kitties-cli",
  "version": "0.1.0",
  "license": "GPL-3.0",
  "private": true,
  "type": "module",
  "types": "dist/index.d.ts",
  "dependencies": {
    "@midnight-ntwrk/kitties-contract": "*",
    "@repo/kitties-api": "^0.0.1",
    "@midnight-ntwrk/example-nft-contracts": "git+https://github.com/midnightntwrk/example-nft-contracts#f38641f13f2968fe0601c8c8dcbed4edfc56b1cf"
  },
  "devDependencies": {
    "eslint": "^9.28.0",
    "typescript": "^5.8.3"
  },
  "scripts": {
    "build": "rm -rf dist && tsc --project tsconfig.build.json",
    "lint": "eslint src",
    "start-preprod-remote": "yarn build && yarn preprod-remote",
    "start-preprod-remote-ps": "yarn build && yarn preprod-remote-ps",
    "start-preview-remote": "yarn build && yarn preview-remote",
    "standalone": "docker compose -f ../standalone.yml pull && node --experimental-specifier-resolution=node --loader ts-node/esm src/standalone.ts",
    "preprod-remote": "node --experimental-specifier-resolution=node --loader ts-node/esm src/preprod-remote.ts",
    "preprod-remote-ps": "cp -r ../proof-server-testnet.yml ./dist/ && node --experimental-specifier-resolution=node --loader ts-node/esm src/preprod-remote-ps.ts",
    "preview-remote": "node --experimental-specifier-resolution=node --loader ts-node/esm src/preview-remote.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}

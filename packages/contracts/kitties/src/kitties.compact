pragma language_version >= 0.23;

import CompactStandardLibrary;

// This contract extends OpenZeppelin's NonFungibleToken module. The module
// owns all token state (owners, balances, approvals) and its circuits handle
// mint and transfer. This contract layers the kitty-specific logic on top:
// DNA generation and breeding.
import "@openzeppelin/compact-contracts/token/NonFungibleToken" prefix NonFungibleToken_;
import "@openzeppelin/compact-contracts/utils/Utils" prefix Utils_;

export { ContractAddress, Either };

// =====================
// Caller identity (witness-derived account id)
// =====================
//
// Each user's DApp holds a 32-byte secret key in private state. The contract
// derives a stable account identifier from it as persistentHash(secretKey) and
// records that identifier as the token owner. To act as an owner, a caller
// re-derives the identifier from their secret inside the circuit, so proving
// ownership means proving knowledge of the secret. The identifier is a
// commitment: it hides the secret and reveals no wallet address.
//
// This is the same identity scheme the imported NonFungibleToken module uses.
// The module derives the caller from its own witness (wit_NonFungibleTokenSK),
// and the kitty circuits below derive it from localSecretKey using the same
// library helper. The DApp must implement both witnesses to return the same
// secret so that both derivations name the same account.
//
// Note: ownPublicKey() cannot be used for authorization. It is an unconstrained
// witness, so a caller can supply any value for it, including someone else's
// public key.
witness localSecretKey(): Bytes<32>;

// Derives the caller's account id from their secret key, using the same
// derivation as the NonFungibleToken module.
circuit computeAccountId(): Bytes<32> {
  return Utils_computeAccountId(localSecretKey());
}

// Wraps a bare account id in the canonical Either form the module stores:
// left branch active, inactive branch zeroed.
circuit accountToEither(id: Bytes<32>): Either<Bytes<32>, ContractAddress> {
  return Either<Bytes<32>, ContractAddress> {
    is_left: true,
    left: id,
    right: default<ContractAddress>
  };
}

// =====================
// CryptoKitties-specific data structures
// =====================

// Enum representing the gender of a kitty.
export enum Gender {
  Male,
  Female
}

// Struct holding the kitty-specific attributes. Ownership is NOT stored here;
// the NonFungibleToken module's ledger is the single source of truth for
// owners, balances, and approvals (query via ownerOf/balanceOf).
export struct Kitty {
  dna: Field,                // Unique DNA for the kitty
  gender: Gender,            // Gender of the kitty
  generation: Uint<32>       // Generation number (0 for original, increments with breeding)
}

// Mapping from kitty ID to kitty data. Token IDs are Uint<128> to match the
// NonFungibleToken module.
export ledger kitties: Map<Uint<128>, Kitty>;

// Counter to track the total number of kitties created.
export ledger allKittiesCount: Counter;

// Boolean used to alternate gender assignment for new kitties.
export ledger genderSelector: Boolean;

// Witness function to retrieve a random number (for DNA generation and breeding).
// WARNING: This is a witness, meaning the value is injected from outside the circuit
// and cannot be fully trusted.
witness createRandomNumber(): Bytes<32>;

// =====================
// Contract Initialization
// =====================

// Contract constructor: initializes the NonFungibleToken module with the
// collection name and symbol, and initializes the kitty counter.
constructor(name: Opaque<"string">, symbol: Opaque<"string">) {
  NonFungibleToken_initialize(name, symbol);
  allKittiesCount.increment(0);
}

// =====================
// Standard NFT surface (delegated to the module)
// =====================

// Returns the collection name.
export circuit name(): Opaque<"string"> {
  return NonFungibleToken_name();
}

// Returns the collection symbol.
export circuit symbol(): Opaque<"string"> {
  return NonFungibleToken_symbol();
}

// Returns the number of kitties owned by an account.
export circuit balanceOf(account: Either<Bytes<32>, ContractAddress>): Uint<128> {
  return NonFungibleToken_balanceOf(account);
}

// Returns the owner of a kitty.
export circuit ownerOf(kittyId: Uint<128>): Either<Bytes<32>, ContractAddress> {
  return NonFungibleToken_ownerOf(kittyId);
}

// Approves an account to transfer a specific kitty. The module authorizes the
// caller via its witness-derived identity.
export circuit approve(to: Either<Bytes<32>, ContractAddress>, kittyId: Uint<128>): [] {
  return NonFungibleToken_approve(to, kittyId);
}

// Returns the account approved for a specific kitty.
export circuit getApproved(kittyId: Uint<128>): Either<Bytes<32>, ContractAddress> {
  return NonFungibleToken_getApproved(kittyId);
}

// Approves or revokes an operator for all of the caller's kitties.
export circuit setApprovalForAll(operator: Either<Bytes<32>, ContractAddress>, approved: Boolean): [] {
  return NonFungibleToken_setApprovalForAll(operator, approved);
}

// Returns whether an operator is approved for all of an owner's kitties.
export circuit isApprovedForAll(
  owner: Either<Bytes<32>, ContractAddress>,
  operator: Either<Bytes<32>, ContractAddress>
): Boolean {
  return NonFungibleToken_isApprovedForAll(owner, operator);
}

// Transfers a kitty. The module verifies the caller is the owner or approved
// (via its witness-derived identity) and moves the token. Approvals for the
// token are cleared on transfer.
export circuit transferFrom(
  sender: Either<Bytes<32>, ContractAddress>,
  to: Either<Bytes<32>, ContractAddress>,
  kittyId: Uint<128>
): [] {
  return NonFungibleToken_transferFrom(sender, to, kittyId);
}

// =====================
// Kitty DNA and Gender Generation
// =====================

// Generates unique DNA for a kitty.
circuit generateDNA(minter: Bytes<32>, kittyId: Uint<128>): Field {
  // In a production implementation, this would use a more secure randomness.
  // Here, we use a hash of the KittyId, minter, contract address, and a witness random number.
  const payload = [kittyId, minter, kernel.self().bytes, createRandomNumber()];
  return transientHash<[Uint<128>, Bytes<32>, Bytes<32>, Bytes<32>]>(payload);
}

// Determines the gender of a new kitty based on the genderSelector flag.
circuit generateGender(): Gender {
  // Alternate gender for each new kitty.
  if (genderSelector) {
    return Gender.Male;
  } else {
    return Gender.Female;
  }
}

// =====================
// Kitty Lifecycle Operations
// =====================

// Creates a new unique kitty. The creator becomes the owner.
export circuit createKitty(): [] {
  // The creator's identity is their witness-derived account id. The module
  // records it as the token owner via _mint.
  const owner = computeAccountId();
  const kittyId = (allKittiesCount.read() + 1) as Uint<128>;
  const kittyDna = generateDNA(owner, kittyId);

  // Ensure the kitty does not already exist.
  assert(!kitties.member(kittyId), "Kitty already exists");

  // Create the kitty-specific attributes.
  const newKitty = Kitty {
    dna: kittyDna,
    gender: generateGender(),
    generation: 0
  };

  // Store the kitty data in the ledger.
  kitties.insert(disclose(kittyId), disclose(newKitty));

  // Record ownership in the NonFungibleToken module.
  NonFungibleToken__mint(accountToEither(owner), kittyId);

  // Increment the total kitty counter.
  allKittiesCount.increment(1);
  // Alternate the gender for the next kitty.
  genderSelector = !genderSelector;
}

// Breeds two kitties to create a new offspring with combined DNA.
// Warning: The DNA combination uses a random seed from a witness.
// The offspring's generation is set to max(parent generations) + 1.
export circuit breedKitty(kittyId1: Uint<128>, kittyId2: Uint<128>): [] {
  // The caller's identity is their witness-derived account id. It is a hiding
  // commitment that is already public as the recorded owner, so it is safe to
  // disclose. Disclosure is required here because the || below short-circuits:
  // whether the second ownerOf's ledger reads run depends on the first
  // comparison's result, and the compiler requires that gating value to be
  // declared public.
  const ownerEither = accountToEither(disclose(computeAccountId()));

  // Ensure both parent kitties exist.
  assert(kitties.member(disclose(kittyId1)), "Parent kitty 1 does not exist");
  assert(kitties.member(disclose(kittyId2)), "Parent kitty 2 does not exist");

  // Ensure the kitties are different (can't breed with itself).
  assert(kittyId1 != kittyId2, "Cannot breed a kitty with itself");

  // Retrieve parent kitty data.
  const kitty1 = kitties.lookup(disclose(kittyId1));
  const kitty2 = kitties.lookup(disclose(kittyId2));

  // Ensure the caller owns at least one of the parent kitties, proven by
  // re-deriving their account id from their secret key.
  assert(
    NonFungibleToken_ownerOf(disclose(kittyId1)) == ownerEither ||
    NonFungibleToken_ownerOf(disclose(kittyId2)) == ownerEither,
    "Must own at least one parent kitty"
  );

  // Generate new kitty ID.
  const newKittyId = (allKittiesCount.read() + 1) as Uint<128>;

  // Ensure the new kitty doesn't already exist.
  assert(!kitties.member(newKittyId), "New kitty already exists");

  // Generate random seed for breeding (witness, not fully trustable).
  const breedingSeed = createRandomNumber();

  // Combine DNA from both parents using the breeding seed.
  const combinedDNA = breedDNA(kitty1.dna, kitty2.dna, breedingSeed, newKittyId);

  // Determine the generation (max of parents + 1).
  const newGeneration = (getMaxGeneration(kitty1.generation, kitty2.generation) + 1) as Uint<32>;

  // Create the new offspring kitty.
  const newKitty = Kitty {
    dna: combinedDNA,
    gender: generateGender(),
    generation: newGeneration
  };

  // Store the new kitty data.
  kitties.insert(disclose(newKittyId), disclose(newKitty));

  // Record ownership of the offspring in the NonFungibleToken module.
  NonFungibleToken__mint(ownerEither, disclose(newKittyId));

  // Increment the total kitty counter.
  allKittiesCount.increment(1);
  // Alternate the gender for the next kitty.
  genderSelector = !genderSelector;
}

// Retrieves and returns information about a specific kitty by its ID.
// Ownership is not part of the Kitty struct; query it via ownerOf.
// Throws an error if the kitty does not exist.
export circuit getKitty(kittyId: Uint<128>): Kitty {
  // Ensure the kitty exists in the ledger.
  assert(kitties.member(disclose(kittyId)), "Kitty does not exist");
  return kitties.lookup(disclose(kittyId));
}

// Returns the total number of kitties created.
export circuit getAllKittiesCount(): Uint<64> {
  return allKittiesCount;
}

// Helper function to combine DNA from two parent kitties using a random seed.
// This is a simplified approach: hashes both DNAs and the seed together.
circuit breedDNA(dna1: Field, dna2: Field, seed: Bytes<32>, newKittyId: Uint<128>): Field {
  // Create payload for final DNA combination.
  // In a simplified approach, we'll hash the combination of both DNAs with the seed.
  const combinedPayload = [dna1, dna2, seed, newKittyId];
  return transientHash<[Field, Field, Bytes<32>, Uint<128>]>(combinedPayload);
}

// Helper function to get the maximum of two generation values.
circuit getMaxGeneration(gen1: Uint<32>, gen2: Uint<32>): Uint<32> {
  if (gen1 > gen2) {
    return gen1;
  } else {
    return gen2;
  }
}
